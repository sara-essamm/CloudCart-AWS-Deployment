# Copy this file to ".env" and fill in your own values:
#     cp .env.example .env        (Windows: copy .env.example .env)
# NEVER commit the real .env file to Git.
# If a value contains a # character or spaces, wrap it in double quotes.

# ---- App ----
APP_DEBUG=true              # show PHP errors on screen; set to false on AWS
BEHIND_PROXY=false          # set to true when running behind the Application Load Balancer

# ---- MySQL (local MySQL now, Amazon RDS later) ----
DB_HOST=localhost           # later: your RDS endpoint, e.g. cloudcart.xxxx.us-east-1.rds.amazonaws.com
DB_PORT=3306
DB_NAME=your_database
DB_USER=your_username
DB_PASSWORD="your_password